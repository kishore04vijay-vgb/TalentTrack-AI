# ------------------------------------------------------------------
# SportsVerse AI - backend environment variables
# Copy this file to `.env` and fill in real values. NEVER commit .env.
# ------------------------------------------------------------------

# Local dev default uses SQLite so the project runs with zero setup.
# For deployment use PostgreSQL (e.g. Neon):
#   DATABASE_URL=postgresql+psycopg2://user:password@host/dbname?sslmode=require
DATABASE_URL=sqlite:///./sportsverse.db

# App
APP_NAME=SportsVerse AI API
APP_ENV=development
DEBUG=true
API_V1_PREFIX=/api

# Auth - generate a strong random secret:  openssl rand -hex 32
JWT_SECRET=change-me-to-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# CORS - comma separated origins
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Cloudinary (used for video/image storage)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
